{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "jsx": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleDetection": "force",
    "useDefineForClassFields": true,

    "baseUrl": "./",
    "module": "ESNext",

    /* Bundler mode：@beaver-im/* 走 node_modules(file:) + package.json exports，不必再为每个 app 写 paths */
    "moduleResolution": "bundler",
    "paths": {
      "commonModule/*": ["src/common/*"],
      "renderModule/*": ["src/render/*"],
      "mainModule/*": ["src/main/*"],
      "preloadModule/*": ["src/preload/*"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client", "@types/node"],
    "allowImportingTsExtensions": true,
    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.vue",
    "packages/*/src/**/*.d.ts",
    "../beaver-agent/agent_electron/src/**/*.ts",
    "../beaver-agent/agent_electron/src/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "logs",
    "dist",
    "dist-electron",
    "release"
  ]
}
