{
  "name": "@beaver-im/app-moment",
  "version": "2.1.2",
  "private": true,
  "type": "module",
  "description": "beaver 朋友圈 app：main + moment.html。平台能力走 @beaver-im/beaver",
  "main": "./dist/main.js",
  "exports": {
    "./main": {
      "development": "./src/main/index.ts",
      "default": "./dist/main.js"
    },
    "./common": "./src/common/index.ts",
    "./common/*": "./src/common/*.ts",
    "./renderer": "./src/renderer/index.ts",
    "./renderer/*": "./src/renderer/*.ts",
    "./moment.html": "./dist/moment.html"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "concurrently": "catalog:"
  },
  "scripts": {
    "dev": "concurrently -k -n main,renderer \"vite build --mode main --watch\" \"vite build --mode renderer --watch\"",
    "build_main": "vite build --mode main",
    "build_render": "vite build --mode renderer",
    "build": "pnpm run build_main && pnpm run build_render",
    "package": "pnpm run build_main && pnpm run build_render"
  },
  "dependencies": {
    "@beaver-im/beaver": "file:../beaver",
    "@beaver-im/beaver-ui": "file:../beaver-ui",
    "@beaver-im/beaver-biz": "file:../beaver-biz"
  },
  "peerDependencies": {
    "electron": ">=28",
    "vue": "^3.5.0",
    "pinia": "^4.0.0"
  }
}
