{
  "name": "@beaver-im/app-doc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "beaver 在线文档 app：main + doc.html。TipTap + Yjs 实时协同，平台能力走 @beaver-im/beaver",
  "main": "./dist/main.js",
  "exports": {
    "./main": {
      "development": "./src/main/index.ts",
      "default": "./dist/main.js"
    },
    "./common": "./src/common/index.ts",
    "./common/*": "./src/common/*.ts",
    "./renderer": "./src/renderer/index.ts",
    "./renderer/*": "./src/renderer/*.ts",
    "./doc.html": "./dist/doc.html"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "concurrently": "catalog:"
  },
  "scripts": {
    "dev": "concurrently -k -n main,renderer \"vite build --mode main --watch\" \"vite build --mode renderer --watch\"",
    "build_main": "vite build --mode main",
    "build_render": "vite build --mode renderer",
    "build": "pnpm run build_main && pnpm run build_render",
    "package": "pnpm run build_main && pnpm run build_render"
  },
  "dependencies": {
    "@beaver-im/beaver": "workspace:*",
    "@beaver-im/beaver-ui": "file:../beaver-ui",
    "@beaver-im/beaver-biz": "file:../beaver-biz",
    "@tiptap/core": "^2.6.6",
    "@tiptap/extension-collaboration": "^2.6.6",
    "@tiptap/extension-collaboration-cursor": "^2.6.6",
    "@tiptap/extension-placeholder": "^2.6.6",
    "@tiptap/pm": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "@tiptap/vue-3": "^2.6.6",
    "yjs": "^13.6.19",
    "y-websocket": "^1.5.3"
  },
  "peerDependencies": {
    "electron": ">=28",
    "vue": "^3.5.0",
    "pinia": "^4.0.0"
  }
}
