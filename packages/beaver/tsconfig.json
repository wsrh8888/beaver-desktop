{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./",
    "jsx": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@beaver-im/beaver": ["./src/index.ts"],
      "@beaver-im/beaver/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/renderer/**/*.less"]
}
