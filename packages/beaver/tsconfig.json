{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@beaver-im/beaver": ["./src/common/index.ts"],
      "@packageCommon/*": ["./src/common/*"],
      "@packageMain/*": ["./src/main/*"],
      "@packageRender/*": ["./src/renderer/*"]
    }
  },
  "include": ["src/**/*.ts", "src/renderer/**/*.less"]
}
