{
  "name": "@beaver-im/beaver",
  "version": "2.1.2",
  "private": true,
  "type": "module",
  "description": "Beaver 官方包：common + main + renderer（插件可见门面）。宿主内部类型仍在 src/common",
  "main": "./dist/common.js",
  "types": "./dist/common/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/common/index.ts",
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common.js",
      "default": "./dist/common.js"
    },
    "./common": {
      "development": "./src/common/index.ts",
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common.js",
      "default": "./dist/common.js"
    },
    "./main": {
      "development": "./src/main/index.ts",
      "types": "./dist/main/index.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./renderer": {
      "development": "./src/renderer/index.ts",
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer.js",
      "default": "./dist/renderer.js"
    },
    "./renderer.css": {
      "development": "./src/renderer/assets/style/index.less",
      "default": "./dist/renderer.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "concurrently -k -n common,main,renderer \"vite build --mode common --watch\" \"vite build --mode main --watch\" \"vite build --mode renderer --watch\"",
    "build_common": "vite build --mode common",
    "build_main": "vite build --mode main",
    "build_render": "vite build --mode renderer",
    "tsc": "tsc -p tsconfig.build.json",
    "build": "pnpm run build_common && pnpm run build_main && pnpm run build_render && pnpm run tsc",
    "package": "pnpm run build"
  },
  "peerDependencies": {
    "electron": ">=28"
  },
  "devDependencies": {
    "concurrently": "catalog:",
    "@types/uuid": "^10.0.0",
    "axios": "^1.20.0",
    "less": "^4.9.1",
    "moment": "^2.31.0",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2",
    "vite": "^8.3.0"
  }
}
