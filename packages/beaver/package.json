{
  "name": "@beaver-im/beaver",
  "version": "2.1.2",
  "private": true,
  "type": "module",
  "description": "Beaver 官方包：common + main + renderer（插件可见门面）。宿主内部类型仍在 src/common",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./common": "./dist/index.js",
    "./main": "./dist/main.js",
    "./renderer": "./dist/renderer.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --mode common --watch",
    "build": "vite build --mode common && vite build --mode main && vite build --mode renderer && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "electron": ">=28"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "axios": "^1.20.0",
    "moment": "^2.31.0",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2"
  }
}
