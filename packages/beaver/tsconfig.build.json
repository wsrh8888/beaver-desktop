{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@beaver-im/beaver": ["./src/common/index.ts"],
      "@beaver-im/beaver/*": ["./src/*"],
      "@packageCommon/*": ["./src/common/*"],
      "@packageMain/*": ["./src/main/*"],
      "@packageRender/*": ["./src/renderer/*"]
    },
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/common/index.ts",
    "src/main/index.ts",
    "src/renderer/index.ts",
    "src/common/**/*.ts",
    "src/renderer/vite-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
