{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./",
    "jsx": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@beaver-im/app-audio": ["./src/index.ts"],
      "@beaver-im/app-audio/*": ["./src/*"],
      "@beaver-im/beaver": ["../beaver/src/index.ts"],
      "@beaver-im/beaver/*": ["../beaver/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"]
}
