{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./",
    "jsx": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@beaver-im/beaver-biz": ["./src/index.ts"],
      "@beaver-im/beaver-biz/*": ["./src/*"],
      "@beaver-im/beaver-ui": ["../beaver-ui/src/index.ts"],
      "@beaver-im/beaver-ui/*": ["../beaver-ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
