{
  "name": "@beaver-im/app-circle",
  "version": "2.1.2",
  "private": true,
  "type": "module",
  "description": "beaver 圈子 app：main/renderer + 领域 type（common/type）。平台能力走 @beaver-im/beaver",
  "main": "./dist/main.js",
  "exports": {
    "./main": "./dist/main.js",
    "./circle.html": "./dist/circle.html"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --mode renderer --watch",
    "build_main": "vite build --mode main",
    "build_render": "vite build --mode renderer",
    "build": "pnpm run build_main && pnpm run build_render",
    "package": "pnpm run build_main && pnpm run build_render"
  },
  "dependencies": {
    "@beaver-im/beaver": "file:../beaver",
    "@beaver-im/beaver-ui": "file:../beaver-ui",
    "@beaver-im/beaver-biz": "file:../beaver-biz"
  },
  "peerDependencies": {
    "electron": ">=28",
    "vue": "^3.5.0",
    "pinia": "^4.0.0"
  }
}
