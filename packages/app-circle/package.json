{
  "name": "@beaver-im/app-circle",
  "version": "2.1.2",
  "private": true,
  "type": "module",
  "description": "beaver 圈子 app：main/renderer + 领域 type（common/type）。平台能力走 @beaver-im/beaver",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./common": "./src/common/index.ts",
    "./common/type/*": "./src/common/type/*",
    "./main": "./src/main/index.ts",
    "./main/init-tables": "./src/main/database/init/circle/index.ts",
    "./renderer": "./src/renderer/index.ts",
    "./renderer/*": "./src/renderer/*",
    "./circle-entry": "./src/renderer/windows/circle/main.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "@beaver-im/beaver": "file:../beaver",
    "@beaver-im/beaver-ui": "file:../beaver-ui",
    "@beaver-im/beaver-biz": "file:../beaver-biz",
    "@beaver-im/app-moment": "*"
  }
}
