{
  "name": "beaver",
  "type": "module",
  "version": "2.1.2",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "description": "beaverIM",
  "author": "Robert",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "turbo run dev:desktop --filter=beaver",
    "dev:desktop": "chcp 65001 && vite",
    "build-renderer": "vue-tsc --noEmit && vite build",
    "build-electron": "electron-builder build --publish never --dir",
    "package": "turbo run build --filter=@beaver-im/beaver --filter=@beaver-im/app-* && pnpm run build-renderer && pnpm run build-electron",
    "package:packages": "turbo run build --filter=@beaver-im/beaver --filter=@beaver-im/app-*",
    "package-install": "build\\installer\\index.bat",
    "lint": "eslint . --fix",
    "prepare": "husky",
    "add-copyright-header": "node build/scripts/add-copyright-header.mjs"
  },
  "copyright": "Copyright ? 2025 Beaver. All Rights Reserved.",
  "build": {
    "files": [
      "dist-electron/**/*",
      "resource/**/*",
      "dist/**/*"
    ],
    "asar": true,
    "extends": null,
    "appId": "com.beaver",
    "productName": "beaver",
    "artifactName": "beaver-${version}.${ext}",
    "electronDownload": {
      "mirror": "https://npm.taobao.org/mirrors/electron/"
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resource/app.ico",
      "protocols": {
        "name": "Beaver OAuth Protocol",
        "schemes": [
          "beaver"
        ]
      }
    },
    "nsis": {
      "oneClick": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "beaver",
      "differentialPackage": true,
      "unicode": true,
      "warningsAsErrors": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "your-github-username",
        "repo": "your-repo-name"
      }
    ]
  },
  "dependencies": {
    "@beaver-im/app-about": "file:packages/app-about",
    "@beaver-im/app-ai": "link:../beaver-agent/agent_electron",
    "@beaver-im/app-audio": "file:packages/app-audio",
    "@beaver-im/app-call": "file:packages/app-call",
    "@beaver-im/app-circle": "file:packages/app-circle",
    "@beaver-im/app-image": "file:packages/app-image",
    "@beaver-im/app-moment": "file:packages/app-moment",
    "@beaver-im/app-search": "file:packages/app-search",
    "@beaver-im/app-settings": "file:packages/app-settings",
    "@beaver-im/app-updater": "file:packages/app-updater",
    "@beaver-im/app-video": "file:packages/app-video",
    "@beaver-im/app-workbench": "file:packages/app-workbench",
    "@beaver-im/beaver": "file:packages/beaver",
    "@beaver-im/beaver-biz": "file:packages/beaver-biz",
    "@beaver-im/beaver-ui": "file:packages/beaver-ui",
    "@beaver-im/js-sdk": "^1.0.2",
    "@koa/router": "^15.7.0",
    "better-sqlite3": "^13.0.3",
    "browser-md5-file": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "electron-screenshots": "^0.6.2",
    "electron-store": "^11.0.2",
    "esbuild": "^0.28.2",
    "extract-zip": "^2.0.1",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "livekit-client": "^2.22.3",
    "marked": "^18.0.13",
    "node-machine-id": "^1.1.12",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@koa/cors": "^5.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/crypto-js": "^4.2.2",
    "@types/ini": "^4.1.1",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^15.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.3",
    "@types/postcss-pxtorem": "^6.1.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "ini": "^7.0.0",
    "less": "^4.9.1",
    "lint-staged": "^17.5.1",
    "lodash-es": "^4.18.1",
    "log4js": "^6.9.1",
    "moment": "^2.31.0",
    "pinia": "^4.0.3",
    "postcss-pxtorem": "^6.1.0",
    "systeminformation": "^5.33.10",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-svg-loader": "^5.1.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix"
    ]
  }
}
